@startuml
title Currency Converter - Arquitectura e inversion de dependencias

left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam package<<Domain>> {
    BorderStyle dashed
    BorderThickness 2
    BorderColor #333333
}

legend right
  ..|>  Implementa una interfaz
  -->   Dependencia directa
  ..>   Uso o dependencia
endlegend

package "DOMINIO" <<Domain>> {
    class CurrencyConverter {
        -currencyRateProvider: CurrencyRateProvider
        +convert(moneyAmount: MoneyAmount, to: Currency): Conversion
    }

    class MoneyAmount {
        currency: Currency
        amount: BigDecimal
    }

    class CurrencyRate {
        fromCurrency: Currency
        toCurrency: Currency
        rate: BigDecimal
        timestamp: Instant
    }

    class Conversion {
        converted: MoneyAmount
        rateUsed: CurrencyRate
    }

    interface CurrencyRateProvider <<outbound port>> {
        +getCurrencyRate(from: Currency, to: Currency): CurrencyRate
        +getMultipleCurrencyRates(from: Currency, to: Collection): Collection
        +getHistoricalCurrencyRate(...): CurrencyRate
        +getHistoricalMultipleCurrencyRates(...): Collection
    }

    interface CurrencyCatalog <<outbound port>> {
        +getAvailableCurrencies(): Collection
    }

    class RateNotAvailableException <<domain exception>>
}

package "ADAPTADOR DE APLICACION" {
    class CurrencyApiProvider {
        -currencyApiClient: CurrencyApiClient
        +getCurrencyRate(...): CurrencyRate
        +getMultipleCurrencyRates(...): Collection
        +getHistoricalCurrencyRate(...): CurrencyRate
        +getHistoricalMultipleCurrencyRates(...): Collection
        +getAvailableCurrencies(): Collection
    }
}

package "PUERTO DE INTEGRACION" {
    interface CurrencyApiClient <<integration port>> {
        +getCurrencyRate(...): ExchangeRateResponse
        +getMultipleCurrencyRates(...): ExchangeRateResponse
        +getAvailableCurrencies(): AvailableCurrenciesResponse
        +getHistoricalMultipleCurrencyRates(...): ExchangeRateResponse
    }
}

package "INFRAESTRUCTURA / FREECURRENCYAPI" {
    class FreeCurrencyApiClient {
        -httpClient: HttpClient
        -jsonParser: JsonParser
        -statusChecker: ResponseStatusChecker
    }

    class ResponseStatusChecker {
        -errors: Map
        +check(response: HttpResponse): void
    }

    interface HttpClient {
        +get(url: URI, queryParams: Map, headers: Map): HttpResponse
    }

    class UnirestHttpClient
    interface JsonParser {
        +parse(json: String, type: Class): Object
    }

    class GsonJsonParser
    class HttpResponse
    class ExchangeRateResponse <<external DTO>>
    class AvailableCurrenciesResponse <<external DTO>>

    class HttpTransportException <<infrastructure exception>>
    class CurrencyProviderException <<integration exception>>
    class AuthenticationFailedException <<integration exception>>
    class CurrencyProviderRateLimitException <<integration exception>>
    class CurrencyProviderResourceNotFoundException <<integration exception>>
    class InvalidProviderRequestException <<integration exception>>
    class InvalidProviderResponseException <<integration exception>>
}

package "LIBRERIAS EXTERNAS" {
    class Gson <<external>>
    class Unirest <<external>>
}

package "COMPOSICION" {
    class Main
}

CurrencyConverter --> CurrencyRateProvider : depende de abstraccion
CurrencyConverter --> MoneyAmount
CurrencyConverter --> Conversion
Conversion --> CurrencyRate

CurrencyApiProvider ..|> CurrencyRateProvider
CurrencyApiProvider ..|> CurrencyCatalog
CurrencyApiProvider --> CurrencyApiClient : depende de abstraccion
CurrencyApiProvider --> ExchangeRateResponse : traduce DTO a dominio
CurrencyApiProvider --> AvailableCurrenciesResponse
CurrencyApiProvider ..> RateNotAvailableException : crea ante tasa ausente

FreeCurrencyApiClient ..|> CurrencyApiClient
FreeCurrencyApiClient --> HttpClient : depende de abstraccion
FreeCurrencyApiClient --> JsonParser : depende de abstraccion
FreeCurrencyApiClient --> ResponseStatusChecker
FreeCurrencyApiClient --> ExchangeRateResponse
FreeCurrencyApiClient --> AvailableCurrenciesResponse

ResponseStatusChecker --> HttpResponse
ResponseStatusChecker --> CurrencyProviderException : crea segun status
UnirestHttpClient ..|> HttpClient
UnirestHttpClient ..> HttpTransportException : lanza ante falla de transporte

GsonJsonParser ..|> JsonParser
GsonJsonParser ..> InvalidProviderResponseException : crea ante JSON invalido
UnirestHttpClient --> Unirest
GsonJsonParser --> Gson

Main --> CurrencyConverter
Main --> CurrencyApiProvider
Main --> FreeCurrencyApiClient
Main --> UnirestHttpClient
Main --> GsonJsonParser

note bottom of CurrencyConverter
  Inversion correcta: el dominio depende de CurrencyRateProvider,
  no de CurrencyApiProvider ni de FreeCurrencyApiClient.
end note

note bottom of Main
  Dependencias concretas intencionales: Main es el composition root.
end note

note right of ResponseStatusChecker
  Usa un Map de status a factories.
  No parsea JSON ni crea excepciones de dominio.
end note

@enduml
