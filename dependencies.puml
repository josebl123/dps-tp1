@startuml
title Currency Converter - Arquitectura e inversion de dependencias

left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam package<<Domain>> {
    BorderStyle dashed
    BorderThickness 2
    BorderColor #333333
}

legend right
  ..|>  Implementa una interfaz
  <|--  Hereda de
  -->   Dependencia directa
  ..>   Uso o creacion
endlegend

package "DOMINIO  (model + service)" <<Domain>> {

    class CurrencyConverter {
        -currencyRateProvider: CurrencyRateProvider
        +convert(moneyAmount: MoneyAmount, to: Currency): Conversion
        +convertMultiple(moneyAmount: MoneyAmount, to: Collection): Collection
    }

    class HistoricalCurrencyConverter {
        -historicalCurrencyRateProvider: HistoricalCurrencyRateProvider
        +convert(moneyAmount: MoneyAmount, to: Currency, date: LocalDate): Conversion
        +convertMultiple(moneyAmount: MoneyAmount, to: Collection, date: LocalDate): Collection
    }

    class MoneyAmount {
        currency: Currency
        amount: BigDecimal
        +add(other: MoneyAmount): MoneyAmount
        +convertWithRate(rate: CurrencyRate): MoneyAmount
        +multiply(rate: BigDecimal): BigDecimal
    }

    class CurrencyRate {
        fromCurrency: Currency
        toCurrency: Currency
        rate: BigDecimal
        timestamp: Instant
    }

    class Conversion {
        converted: MoneyAmount
        rateUsed: CurrencyRate
    }

    interface CurrencyRateProvider <<outbound port>> {
        +getCurrencyRate(from: Currency, to: Currency): CurrencyRate
        +getMultipleCurrencyRates(from: Currency, to: Collection): Collection
    }

    interface HistoricalCurrencyRateProvider <<outbound port>> {
        +getHistoricalCurrencyRate(...): CurrencyRate
        +getHistoricalMultipleCurrencyRates(...): Collection
    }

    interface CurrencyCatalog <<outbound port>> {
        +getAvailableCurrencies(): Collection
    }

    class RateNotAvailableException <<domain exception>>
}

package "ADAPTADOR DE APLICACION  (client.currencyapi)" {
    class CurrencyApiProvider {
        -currencyApiClient: CurrencyApiClient
        +getCurrencyRate(...): CurrencyRate
        +getMultipleCurrencyRates(...): Collection
        +getHistoricalCurrencyRate(...): CurrencyRate
        +getHistoricalMultipleCurrencyRates(...): Collection
        +getAvailableCurrencies(): Collection
    }

    interface CurrencyApiClient <<integration port>> {
        +getRates(...): Collection<CurrencyRate>
        +getHistoricalRates(...): Collection<CurrencyRate>
        +getAvailableCurrencies(): Collection<Currency>
    }

    class FreeCurrencyApiClient {
        -httpClient: HttpClient
        -jsonParser: JsonParser
        -responseStatusChecker: ResponseStatusChecker
        +{static} defaultStatusChecker(): ResponseStatusChecker
    }
}

package "DTOs DE FREECURRENCYAPI  (client.currencyapi.freecurrencyapi.response)" {
    class ExchangeRateResponse <<external DTO>>
    class HistoricalExchangeRateResponse <<external DTO>>
    class AvailableCurrenciesResponse <<external DTO>>
}

package "ERRORES DE INTEGRACION  (client.error)" {
    class CurrencyProviderException <<integration exception>> {
        -statusCode: int
        -responseBody: String
    }
    class AuthenticationFailedException
    class CurrencyProviderRateLimitException
    class CurrencyProviderResourceNotFoundException
    class InvalidProviderRequestException
    class InvalidProviderResponseException
}

package "HTTP  (http)" {
    interface HttpClient {
        +get(url: URI, queryParams: Map, headers: Map): HttpResponse
    }
    class UnirestHttpClient
    class HttpResponse {
        body: String
        statusCode: int
    }
    class ResponseStatusChecker {
        -errors: Map<Integer, Function>
        -defaultError: Function
        +check(response: HttpResponse): void
    }
    class HttpTransportException <<infrastructure exception>>
}

package "PARSER  (parser)" {
    interface JsonParser {
        +parse(json: String, type: Class): Object
    }
    class GsonJsonParser
    class JsonParseException <<parser exception>>
}

package "LIBRERIAS EXTERNAS" {
    class Gson <<external>>
    class Unirest <<external>>
}

package "COMPOSICION" {
    class Main
}

CurrencyConverter --> CurrencyRateProvider : depende de abstraccion
CurrencyConverter --> MoneyAmount
CurrencyConverter --> Conversion
HistoricalCurrencyConverter --> HistoricalCurrencyRateProvider : depende de abstraccion
HistoricalCurrencyConverter --> MoneyAmount
HistoricalCurrencyConverter --> Conversion
Conversion --> MoneyAmount
Conversion --> CurrencyRate

CurrencyApiProvider ..|> CurrencyRateProvider
CurrencyApiProvider ..|> HistoricalCurrencyRateProvider
CurrencyApiProvider ..|> CurrencyCatalog
CurrencyApiProvider --> CurrencyApiClient : depende de abstraccion

FreeCurrencyApiClient ..|> CurrencyApiClient
FreeCurrencyApiClient --> HttpClient : depende de abstraccion
FreeCurrencyApiClient --> JsonParser : depende de abstraccion
FreeCurrencyApiClient --> ResponseStatusChecker
FreeCurrencyApiClient --> ExchangeRateResponse
FreeCurrencyApiClient --> HistoricalExchangeRateResponse
FreeCurrencyApiClient --> AvailableCurrenciesResponse
FreeCurrencyApiClient ..> RateNotAvailableException : crea ante tasa ausente

CurrencyProviderException <|-- AuthenticationFailedException
CurrencyProviderException <|-- CurrencyProviderRateLimitException
CurrencyProviderException <|-- CurrencyProviderResourceNotFoundException
CurrencyProviderException <|-- InvalidProviderRequestException
CurrencyProviderException <|-- InvalidProviderResponseException
CurrencyProviderException --> HttpResponse : conserva status y body

ResponseStatusChecker --> HttpResponse
ResponseStatusChecker ..> CurrencyProviderException : crea segun status

UnirestHttpClient ..|> HttpClient
UnirestHttpClient ..> HttpTransportException : lanza ante falla de transporte
UnirestHttpClient --> Unirest

GsonJsonParser ..|> JsonParser
GsonJsonParser ..> JsonParseException : crea ante JSON invalido
GsonJsonParser --> Gson

Main --> CurrencyConverter
Main --> HistoricalCurrencyConverter
Main --> CurrencyApiProvider
Main --> FreeCurrencyApiClient
Main --> UnirestHttpClient
Main --> GsonJsonParser

note bottom of CurrencyConverter
  Inversion correcta: el dominio depende de CurrencyRateProvider,
  no de CurrencyApiProvider ni de FreeCurrencyApiClient.
  Sin interfaz propia: nadie necesita depender del converter
  sin conocer su implementacion.
end note

note bottom of HistoricalCurrencyConverter
  ISP: las tasas actuales y las historicas son puertos separados.
  Un consumidor de cotizaciones actuales no queda obligado a conocer
  operaciones historicas que no usa.
end note

note bottom of Main
  Dependencias concretas intencionales: Main es el composition root.
  Es el unico punto que captura las excepciones y las notifica.
end note

note right of ResponseStatusChecker
  Usa un Map de status a factories de excepcion.
  Vive en http: no parsea JSON ni conoce el dominio.
end note

note as N1
  Las tres jerarquias de excepcion no comparten raiz:
  CurrencyProviderException, HttpTransportException
  y RateNotAvailableException extienden RuntimeException
  por separado, asi que Main captura las tres.
end note

N1 .. CurrencyProviderException
N1 .. HttpTransportException
N1 .. RateNotAvailableException

@enduml
